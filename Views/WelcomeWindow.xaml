<Window x:Class="UnlockWelcome.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Normal"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        Background="#070910" AllowsTransparency="False">
    <Grid x:Name="Root" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"/>
        <MediaElement x:Name="BackgroundVideo" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Stop" IsMuted="True" Visibility="Collapsed" MediaOpened="BackgroundVideo_MediaOpened" MediaEnded="BackgroundVideo_MediaEnded"/>
        <Rectangle x:Name="BackgroundOverlay" Fill="#50000000"/>
        <Ellipse x:Name="GlowOrb" Width="620" Height="620" Opacity="0.18"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
        </Ellipse>
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="900">
            <StackPanel x:Name="ContentPanel" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock x:Name="Eyebrow" Text="YOUR SPACE. YOUR MOMENT."
                           Foreground="#91A9E8" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Stretch" TextAlignment="Center" Opacity="0"/>
                <TextBlock x:Name="Greeting" Text="Welcome back." Foreground="#F5F7FF"
                           FontSize="58" FontWeight="Light" HorizontalAlignment="Stretch"
                           Margin="0,28,0,0" TextAlignment="Center" TextWrapping="Wrap" Opacity="0"/>
                <TextBlock x:Name="Subtitle" Text="很高興再次見到你。" Foreground="#AAB5CC"
                           FontSize="18" FontWeight="Light" HorizontalAlignment="Stretch"
                           Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap" Opacity="0"/>
                <Border x:Name="AccentLine" Width="150" Height="1" Background="#8FAEFF"
                        Margin="0,34,0,0" HorizontalAlignment="Center" Opacity="0"/>
                <TextBlock x:Name="DateText" Foreground="#75829E" FontSize="12"
                           HorizontalAlignment="Stretch" TextAlignment="Center"
                           Margin="0,28,0,0" Opacity="0"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="UNLOCK WELCOME" Foreground="#8792A8" FontSize="9"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" Opacity="0.65"/>
        <Button x:Name="DismissButton" Content="跳過  ›" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,34,26" Padding="14,8"
                Background="#66202A40" Foreground="#F4F6FC" BorderBrush="#66758D"
                FontSize="11" Click="Dismiss_Click" Opacity="0.85"/>
    </Grid>
</Window>
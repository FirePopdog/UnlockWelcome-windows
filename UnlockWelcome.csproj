<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UnlockWelcome</AssemblyName>
    <RootNamespace>UnlockWelcome</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>UnlockWelcome Contributors</Authors>
    <Description>A cinematic welcome animation shown when you unlock Windows.</Description>
  </PropertyGroup>
</Project>
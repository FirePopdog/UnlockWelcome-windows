<Window x:Class="UnlockWelcome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnlockWelcome 設定" Height="510" Width="680"
        WindowStartupLocation="CenterScreen" Background="#0B0D13"
        Foreground="#F4F6FC" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="UNLOCK WELCOME" Foreground="#91A9FF" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Make every return feel cinematic." FontSize="27" FontWeight="SemiBold" Margin="0,12,0,5"/>
            <TextBlock Text="每次回到桌面，都有一個專屬的歡迎時刻。" Foreground="#9AA3B7" FontSize="13"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#151925" CornerRadius="16" Padding="22" Margin="0,28,0,22">
            <StackPanel>
                <TextBlock Text="一般設定" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <CheckBox x:Name="StartupCheckBox" Content="登入 Windows 時自動啟動" FontSize="14" Margin="0,0,0,20" Foreground="#E7EAF3"/>
                <TextBlock Text="歡迎訊息" Foreground="#AAB3C7" Margin="0,0,0,7"/>
                <TextBox x:Name="GreetingTextBox" Text="Welcome back." FontSize="15" Padding="10" Background="#202637" Foreground="White" BorderBrush="#343D52"/>
                <TextBlock Text="副標題" Foreground="#AAB3C7" Margin="0,16,0,7"/>
                <TextBox x:Name="SubtitleTextBox" Text="很高興再次見到你。" FontSize="14" Padding="10" Background="#202637" Foreground="White" BorderBrush="#343D52"/>
                <TextBlock Text="動畫顯示時間" Foreground="#AAB3C7" Margin="0,17,0,8"/>
                <ComboBox x:Name="DurationComboBox" Width="180" HorizontalAlignment="Left" SelectedIndex="1" Padding="7">
                    <ComboBoxItem Content="3 秒" Tag="3"/>
                    <ComboBoxItem Content="5 秒" Tag="5"/>
                    <ComboBoxItem Content="8 秒" Tag="8"/>
                    <ComboBoxItem Content="手動關閉" Tag="0"/>
                </ComboBox>
                <TextBlock Text="提示：目前版本會在每次解鎖 Windows 時播放動畫。" Foreground="#77839B" FontSize="11" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock Text="UnlockWelcome  •  v1.0.0" Foreground="#66718A" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="預覽動畫" Click="Preview_Click" Padding="16,9" Margin="0,0,10,0" Background="#202A40" Foreground="White" BorderThickness="0"/>
                <Button Content="儲存設定" Click="Save_Click" Padding="18,9" Background="#7898F8" Foreground="#101522" FontWeight="SemiBold" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
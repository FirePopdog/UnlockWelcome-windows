<Window x:Class="UnlockWelcome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnlockWelcome Studio" Height="820" Width="1220" MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#0A0D14" Foreground="#F4F6FC"
        FontFamily="Segoe UI" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141A27"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8792A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#91A9FF"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1420"/>
            <Setter Property="Foreground" Value="#F3F5FC"/>
            <Setter Property="BorderBrush" Value="#303A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1420"/>
            <Setter Property="Foreground" Value="#F3F5FC"/>
            <Setter Property="BorderBrush" Value="#303A50"/>
            <Setter Property="Padding" Value="9,7"/>
                        <Setter Property="MinHeight" Value="38"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F3F5FC"/>
                        <Setter Property="Background" Value="#151B29"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#293A5B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#243451"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE2F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FF"/>
            <Setter Property="Background" Value="#202A3B"/>
            <Setter Property="BorderBrush" Value="#34415A"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#98A4BA"/>
            <Setter Property="Background" Value="#111725"/>
            <Setter Property="Padding" Value="19,12"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#293348"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D121D" BorderBrush="#222B3B" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#202E4D" HorizontalAlignment="Left">
                        <TextBlock Text="U" FontSize="23" FontWeight="Bold" Foreground="#AFC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="UNLOCK WELCOME" FontSize="12" FontWeight="Bold" Foreground="#AFC2FF" Margin="0,17,0,4"/>
                    <TextBlock Text="STUDIO" FontSize="10" Foreground="#68758C"/>
                    <Border Height="1" Background="#242E41" Margin="0,24,0,17"/>
                    <TextBlock Text="控制台" FontSize="11" Foreground="#69768D" Margin="0,0,0,9"/>
                    <TextBlock Text="設計你的解鎖時刻" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="讓每次回到桌面，都有自己的風格。" FontSize="11" Foreground="#8490A6" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <Border Background="#171F30" CornerRadius="10" Padding="11" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="目前啟用主題" FontSize="10" Foreground="#8490A6"/>
                            <TextBlock x:Name="ActiveThemeLabel" Text="Cinematic" FontSize="14" FontWeight="SemiBold" Foreground="#C5D2FF" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#242E41" Margin="0,12,0,13"/>
                    <TextBlock Text="UNLOCKWELCOME  •  1.1.0" FontSize="10" Foreground="#68758C"/>
                    <TextBlock Text="Open source · MIT License" FontSize="10" Foreground="#58647A" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="WELCOME EXPERIENCE" Foreground="#8FAAFF" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="動畫工作室" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="匯入主題" Click="Import_Click" Margin="0,0,9,0"/>
                    <Button Content="匯出主題" Click="Export_Click" Margin="0,0,9,0"/>
                    <Button Content="儲存變更" Click="Save_Click" Background="#7898F8" Foreground="#101522" BorderBrush="#7898F8" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>

            <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="主題中心">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,19,4,15">
                            <TextBlock Text="選擇你的風格" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="套用預設主題作為起點，之後仍可自由修改每一項細節。" Foreground="#8792A8" FontSize="12" Margin="0,6,0,18"/>
                            <UniformGrid Columns="3" Rows="2">
                                <Border Background="#151E31" CornerRadius="13" Padding="15" Tag="Cinematic" MouseLeftButtonUp="ThemeCard_Click" Cursor="Hand" Margin="0,0,12,12" BorderBrush="#526B9D" BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="74" CornerRadius="9" Background="#0B1020">
                                            <Grid>
                                                <Ellipse Width="75" Height="75" Fill="#344C83" Opacity="0.65"><Ellipse.Effect><BlurEffect Radius="25"/></Ellipse.Effect></Ellipse>
                                                <TextBlock Text="Welcome back." Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Cinematic" FontWeight="SemiBold" Margin="0,11,0,3"/>
                                        <TextBlock Text="深色電影感、柔和光暈" Foreground="#8792A8" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#151E31" CornerRadius="13" Padding="15" Tag="Aurora" MouseLeftButtonUp="ThemeCard_Click" Cursor="Hand" Margin="0,0,12,12">
                                    <StackPanel>
                                        <Border Height="74" CornerRadius="9" Background="#081D24">
                                            <Grid><Ellipse Width="90" Height="90" Fill="#1E9A9A" Opacity="0.5"><Ellipse.Effect><BlurEffect Radius="25"/></Ellipse.Effect></Ellipse><TextBlock Text="Good to see you." Foreground="#D8FFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Grid>
                                        </Border>
                                        <TextBlock Text="Aurora" FontWeight="SemiBold" Margin="0,11,0,3"/>
                                        <TextBlock Text="極光色彩、流動氛圍" Foreground="#8792A8" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#151E31" CornerRadius="13" Padding="15" Tag="Minimal" MouseLeftButtonUp="ThemeCard_Click" Cursor="Hand" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Height="74" CornerRadius="9" Background="#E7EAF0">
                                            <TextBlock Text="Welcome." Foreground="#1C2638" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/>
                                        </Border>
                                        <TextBlock Text="Minimal" FontWeight="SemiBold" Margin="0,11,0,3"/>
                                        <TextBlock Text="留白、乾淨、極簡" Foreground="#8792A8" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#151E31" CornerRadius="13" Padding="15" Tag="Neon" MouseLeftButtonUp="ThemeCard_Click" Cursor="Hand" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Height="74" CornerRadius="9" Background="#170D24">
                                            <Grid><Ellipse Width="100" Height="100" Fill="#A13EE8" Opacity="0.55"><Ellipse.Effect><BlurEffect Radius="30"/></Ellipse.Effect></Ellipse><TextBlock Text="SYSTEM ONLINE" Foreground="#F9E6FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                        </Border>
                                        <TextBlock Text="Neon" FontWeight="SemiBold" Margin="0,11,0,3"/>
                                        <TextBlock Text="霓虹、科技、強烈對比" Foreground="#8792A8" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#151E31" CornerRadius="13" Padding="15" Tag="Midnight" MouseLeftButtonUp="ThemeCard_Click" Cursor="Hand" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Height="74" CornerRadius="9" Background="#151A22">
                                            <Grid><Ellipse Width="100" Height="100" Fill="#967B4A" Opacity="0.45"><Ellipse.Effect><BlurEffect Radius="30"/></Ellipse.Effect></Ellipse><TextBlock Text="Welcome home." Foreground="#F6EBD7" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                        </Border>
                                        <TextBlock Text="Midnight" FontWeight="SemiBold" Margin="0,11,0,3"/>
                                        <TextBlock Text="沉穩、暖金、夜色" Foreground="#8792A8" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#151E31" CornerRadius="13" Padding="15" Tag="Fluent" MouseLeftButtonUp="ThemeCard_Click" Cursor="Hand">
                                    <StackPanel>
                                        <Border Height="74" CornerRadius="9" Background="#DCE9FA">
                                            <TextBlock Text="Hello again." Foreground="#253B5A" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Fluent" FontWeight="SemiBold" Margin="0,11,0,3"/>
                                        <TextBlock Text="Windows 風格、清透" Foreground="#8792A8" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Background="#151B29" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="目前選擇的主題" FontSize="12" Foreground="#8792A8"/>
                                        <TextBlock Text="主題套用後可再到「畫面設計」與「動畫效果」進行細部調整。" FontSize="11" Foreground="#66748D" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="Theme_SelectionChanged">
                                        <ComboBoxItem Content="Cinematic"/>
                                        <ComboBoxItem Content="Aurora"/>
                                        <ComboBoxItem Content="Minimal"/>
                                        <ComboBoxItem Content="Neon"/>
                                        <ComboBoxItem Content="Midnight"/>
                                        <ComboBoxItem Content="Fluent"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="畫面設計">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,19,4,15">
                            <TextBlock Text="內容與外觀" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="打造屬於你的文字、背景與配色。" Foreground="#8792A8" FontSize="12" Margin="0,6,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#151B29" CornerRadius="13" Padding="18" Margin="0,0,10,12">
                                    <StackPanel>
                                        <TextBlock Text="文字內容" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                        <TextBlock Text="主標題" Foreground="#8792A8" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBox x:Name="GreetingTextBox" Text="Welcome back."/>
                                        <TextBlock Text="副標題" Foreground="#8792A8" FontSize="11" Margin="0,14,0,6"/>
                                        <TextBox x:Name="SubtitleTextBox" Text="很高興再次見到你。"/>
                                        <CheckBox x:Name="ShowDateCheckBox" Content="顯示日期與時間"/>
                                        <TextBlock Text="文字對齊" Foreground="#8792A8" FontSize="11" Margin="0,13,0,6"/>
                                        <ComboBox x:Name="TextAlignmentComboBox">
                                            <ComboBoxItem Content="置中" Tag="Center"/>
                                            <ComboBoxItem Content="靠左" Tag="Left"/>
                                            <ComboBoxItem Content="靠右" Tag="Right"/>
                                        </ComboBox>
                                        <TextBlock Text="標題字體大小" Foreground="#8792A8" FontSize="11" Margin="0,15,0,4"/>
                                        <Slider x:Name="FontSizeSlider" Minimum="28" Maximum="100" Value="58"/>
                                        <TextBlock x:Name="FontSizeValue" Text="58 px" Foreground="#AFC2FF" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#151B29" CornerRadius="13" Padding="18" Margin="10,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="顏色與背景" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                        <TextBlock Text="強調色 HEX" Foreground="#8792A8" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBox x:Name="AccentColorTextBox" Text="#91A9FF"/>
                                        <TextBlock Text="背景色 HEX" Foreground="#8792A8" FontSize="11" Margin="0,14,0,6"/>
                                        <TextBox x:Name="BackgroundColorTextBox" Text="#070910"/>
                                        <TextBlock Text="標題文字色 HEX" Foreground="#8792A8" FontSize="11" Margin="0,14,0,6"/>
                                        <TextBox x:Name="TitleColorTextBox" Text="#F5F7FF"/>
                                        <TextBlock Text="標題字型" Foreground="#8792A8" FontSize="11" Margin="0,14,0,6"/>
                                        <ComboBox x:Name="FontFamilyComboBox">
                                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                            <ComboBoxItem Content="Arial" Tag="Arial"/>
                                            <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                            <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                                            <ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/>
                                        </ComboBox>
                                        <TextBlock Text="背景媒體已集中在「載入畫面」分頁管理。" Foreground="#68758C" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                                <TabItem Header="載入畫面">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,19,4,15">
                            <TextBlock Text="自訂你的解鎖片頭" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="每次解鎖時先播放自己的影片、GIF 或圖片，再接上歡迎動畫。素材會複製到 UnlockWelcome 資料夾，原始檔移動後仍可播放。" Foreground="#8792A8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"/>
                            <Border Background="#151B29" CornerRadius="13" Padding="18" Margin="0,0,0,13">
                                <StackPanel>
                                    <CheckBox x:Name="EnableLoadingScreenCheckBox" Content="啟用自訂載入片頭" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="片頭主標題" Foreground="#8792A8" FontSize="11" Margin="0,13,0,6"/>
                                    <TextBox x:Name="LoadingTitleTextBox" Text="WELCOME TO YOUR SPACE"/>
                                    <TextBlock Text="片頭副標題" Foreground="#8792A8" FontSize="11" Margin="0,13,0,6"/>
                                    <TextBox x:Name="LoadingSubtitleTextBox" Text="正在為你準備專屬桌面"/>
                                    <TextBlock Text="狀態文字" Foreground="#8792A8" FontSize="11" Margin="0,13,0,6"/>
                                    <TextBox x:Name="LoadingStatusTextBox" Text="INITIALIZING EXPERIENCE"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ShowLoadingProgressCheckBox" Content="顯示動態進度條"/>
                                        <ComboBox x:Name="LoadingDurationComboBox" Grid.Column="1">
                                            <ComboBoxItem Content="1 秒" Tag="1"/>
                                            <ComboBoxItem Content="2 秒" Tag="2"/>
                                            <ComboBoxItem Content="3 秒" Tag="3"/>
                                            <ComboBoxItem Content="5 秒" Tag="5"/>
                                            <ComboBoxItem Content="8 秒" Tag="8"/>
                                            <ComboBoxItem Content="不自動切換" Tag="0"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="片頭播放時間" Foreground="#8792A8" FontSize="10" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#151B29" CornerRadius="13" Padding="18" Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="背景媒體素材" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="影片可使用 MP4、WMV、AVI；GIF 會逐格播放；也可選靜態圖片。影片解碼能力依 Windows 媒體編碼器而定。" Foreground="#8792A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                    <TextBox x:Name="MediaSummaryTextBox" IsReadOnly="True" Text="尚未選擇背景媒體"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="選擇影片" Click="BrowseVideoBackground_Click" Margin="0,0,8,8"/>
                                        <Button Content="選擇 GIF" Click="BrowseGifBackground_Click" Margin="0,0,8,8"/>
                                        <Button Content="選擇圖片" Click="BrowseBackground_Click" Margin="0,0,8,8"/>
                                        <Button Content="移除素材" Click="ClearBackground_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="MuteVideoCheckBox" Content="影片靜音播放（建議開啟）" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#151B29" CornerRadius="13" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="使用流程" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="選擇媒體 → 編輯片頭文字 → 設定片頭時間 → 預覽 → 儲存。GIF 會保留動畫影格；影片會循環播放直到片頭結束。" Foreground="#8792A8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
<TabItem Header="動畫效果">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,19,4,15">
                            <TextBlock Text="動態效果控制" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="自訂動畫的進場方式、粒子數量、速度與播放時間。" Foreground="#8792A8" FontSize="12" Margin="0,6,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#151B29" CornerRadius="13" Padding="18" Margin="0,0,10,12">
                                    <StackPanel>
                                        <TextBlock Text="動畫設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                        <TextBlock Text="進場動畫" Foreground="#8792A8" FontSize="11" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="AnimationStyleComboBox">
                                            <ComboBoxItem Content="淡入 Fade" Tag="Fade"/>
                                            <ComboBoxItem Content="縮放 Zoom" Tag="Zoom"/>
                                            <ComboBoxItem Content="滑入 Slide" Tag="Slide"/>
                                            <ComboBoxItem Content="柔焦 Blur" Tag="Blur"/>
                                            <ComboBoxItem Content="彈跳 Bounce" Tag="Bounce"/>
                                            <ComboBoxItem Content="逐字顯示 Typewriter" Tag="Typewriter"/>
                                            <ComboBoxItem Content="故障閃爍 Glitch" Tag="Glitch"/>
                                        </ComboBox>
                                        <TextBlock Text="顯示時間" Foreground="#8792A8" FontSize="11" Margin="0,15,0,6"/>
                                        <ComboBox x:Name="DurationComboBox">
                                            <ComboBoxItem Content="3 秒" Tag="3"/>
                                            <ComboBoxItem Content="5 秒" Tag="5"/>
                                            <ComboBoxItem Content="8 秒" Tag="8"/>
                                            <ComboBoxItem Content="10 秒" Tag="10"/>
                                            <ComboBoxItem Content="15 秒" Tag="15"/>
                                            <ComboBoxItem Content="持續顯示，手動關閉" Tag="0"/>
                                        </ComboBox>
                                        <TextBlock Text="顯示器" Foreground="#8792A8" FontSize="11" Margin="0,15,0,6"/>
                                        <ComboBox x:Name="DisplayTargetComboBox">
                                            <ComboBoxItem Content="主要螢幕" Tag="Primary"/>
                                            <ComboBoxItem Content="所有螢幕" Tag="All"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#151B29" CornerRadius="13" Padding="18" Margin="10,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="粒子與光效" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                        <CheckBox x:Name="ParticlesCheckBox" Content="啟用漂浮粒子"/>
                                        <TextBlock Text="粒子數量" Foreground="#8792A8" FontSize="11" Margin="0,13,0,4"/>
                                        <Slider x:Name="ParticleCountSlider" Minimum="0" Maximum="100" Value="34"/>
                                        <TextBlock x:Name="ParticleCountValue" Text="34 個" Foreground="#AFC2FF" FontSize="11"/>
                                        <TextBlock Text="粒子速度" Foreground="#8792A8" FontSize="11" Margin="0,15,0,6"/>
                                        <ComboBox x:Name="ParticleSpeedComboBox">
                                            <ComboBoxItem Content="慢速" Tag="Slow"/>
                                            <ComboBoxItem Content="正常" Tag="Normal"/>
                                            <ComboBoxItem Content="快速" Tag="Fast"/>
                                        </ComboBox>
                                        <CheckBox x:Name="GlowCheckBox" Content="啟用文字柔光"/>
                                        <TextBlock Text="提示：粒子數量越高，動態效果越豐富，也會增加 GPU 使用量。" Foreground="#68758C" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="程式設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,19,4,15">
                            <TextBlock Text="程式與啟動" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="管理背景執行、解鎖觸發及主題檔案。" Foreground="#8792A8" FontSize="12" Margin="0,6,0,20"/>
                            <Border Background="#151B29" CornerRadius="13" Padding="20" Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="Windows 整合" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="StartupCheckBox" Content="登入 Windows 後自動在背景啟動"/>
                                    <TextBlock Text="啟用後，程式會常駐系統匣，並在每次解鎖時播放目前啟用的動畫。" Foreground="#8792A8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#151B29" CornerRadius="13" Padding="20" Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="主題檔案" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="將目前所有文字、顏色、背景與動畫參數匯出成 JSON 主題檔，分享給其他使用者；也可以匯入別人製作的主題。" Foreground="#8792A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="匯入 JSON" Click="Import_Click" Margin="0,0,9,0"/>
                                        <Button Content="匯出 JSON" Click="Export_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="#151B29" CornerRadius="13" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="預覽與測試" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="預覽不會觸發真正的 Windows 解鎖事件，也不會改變鎖定畫面。" Foreground="#8792A8" FontSize="11" Margin="0,0,0,13"/>
                                    <Button Content="立即預覽目前動畫" Click="Preview_Click" HorizontalAlignment="Left" Background="#7898F8" Foreground="#101522" BorderBrush="#7898F8" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="2" Margin="0,15,0,0">
                <TextBlock Text="設定會儲存在你的 Windows 使用者資料夾，不會上傳。" Foreground="#68758C" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="預覽動畫" Click="Preview_Click" Margin="0,0,9,0" Padding="17,10"/>
                    <Button Content="套用並儲存" Click="Save_Click" Background="#7898F8" Foreground="#101522" BorderBrush="#7898F8" FontWeight="Bold" Padding="20,10"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
